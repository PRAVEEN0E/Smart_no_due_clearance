generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN // New role for multi-tenant system admins
  MENTOR
  STAFF
  STUDENT
}

enum SubjectType {
  FULL_THEORY
  FULL_LAB
  THEORY_WITH_LAB
}

// MULTI-TENANT: College Model
model College {
  id        String   @id @default(uuid())
  name      String
  domain    String?  // Optional domain routing
  createdAt DateTime @default(now())

  // Branding & Customization
  logoUrl      String?
  primaryColor String?  @default("#7c3aed")
  secondaryColor String? @default("#a855f7")
  affiliationText String? @default("(An Autonomous Institution, affiliated to Anna University)")
  controllerName  String? @default("M. Arulselvan")
  principalName   String? @default("P. Velavan")
  workflow     Json?    // Array of requirement objects {id, label, type, required}
  isMaintenanceMode Boolean @default(false)
  
  users        User[]
  subjects     Subject[]
  announcements Announcement[]
  customRoles  CustomRole[]
  auditLogs    AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique // Keep global for login purposes
  registerNumber String? @unique // New field for student login
  passwordHash String
  role         Role
  dob          String?  // e.g. "12/04/2004"
  signatureUrl String?  // For digital signatures (Staff/Mentor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // MULTI-TENANT RELATION
  collegeId    String?
  college      College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  // RBAC Extension
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  // Relations
  staffSubjects   StaffSubject[]   @relation("StaffToSubjects")
  studentSubjects StudentSubject[] @relation("StudentToSubjects")
  evaluations     Evaluation[]     @relation("EvaluationStudent")
  staffEvaluations Evaluation[]    @relation("EvaluationStaff")
  feeRecord       FeeRecord?
  assignments     Assignment[]
  hallTicket      HallTicket?
  notifications   Notification[]
  materials       Material[] @relation("UploadedMaterials")
  examAttendances   ExamAttendance[] @relation("StudentAttendance")
  scannedAttendances ExamAttendance[] @relation("StaffAttendanceScans")
  auditLogs       AuditLog[]
  announcements   Announcement[]

  createdById     String?
  createdBy       User?            @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers    User[]           @relation("UserCreator")
  createdSubjects Subject[]        @relation("SubjectCreator")
  department     String?          // e.g., 'CSE', 'ECE', 'MECH'
  className      String?          // e.g., 'III Year CSE - A', 'II Year ECE - B'
  customClearance Json?           // Clearance checklist status e.g. { "LIBRARY": { cleared: true, updatedAt: "..." } }
  passwordChangedAt DateTime?     // Track if user has changed their initial password

  @@index([collegeId])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g., 'MARK_UPDATE', 'APPROVAL', 'USER_MANAGEMENT'
  details   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([collegeId])
}

model Subject {
  id          String      @id @default(uuid())
  name        String
  code        String      
  type        SubjectType @default(FULL_THEORY)
  createdAt   DateTime    @default(now())
  createdById String?
  createdBy   User?       @relation("SubjectCreator", fields: [createdById], references: [id])
  
  // MULTI-TENANT RELATION
  collegeId   String?
  college     College?    @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  // Relations
  staffAssignments   StaffSubject[]
  studentAssignments StudentSubject[]
  evaluations        Evaluation[]
  assignments        Assignment[]
  materials          Material[]
  examAttendances    ExamAttendance[]
  syllabusText       String?     @db.Text
  
  // Dynamic Exam Scheduling
  semester    Int?        @default(4)
  examDate    String?     // e.g. "01/06/2026"
  examSession String?     @default("FN") // FN or AN

  // A subject code is only unique WITHIN a specific college
  @@unique([code, collegeId])
}

model StaffSubject {
  id        String @id @default(uuid())
  staffId   String
  subjectId String

  staff   User    @relation("StaffToSubjects", fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId])
}

model StudentSubject {
  id        String @id @default(uuid())
  studentId String
  subjectId String

  student User    @relation("StudentToSubjects", fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model Evaluation {
  id                String    @id @default(uuid())
  studentId        String
  subjectId        String
  staffId          String?
  
  // Marks components
  cat1              Int?      // Max 50
  cat2              Int?      // Max 50
  cat3              Int?      // Max 50
  
  assignment1       Int?      // Max 10
  assignment2       Int?      // Max 10
  assignment3       Int?      // Max 10
  assignment4       Int?      // Max 10
  assignment5       Int?      // Max 10
  
  activity1         Int?      @default(0) // Max 10
  activity2         Int?      @default(0) // Max 10
  
  modelLabMarks     Int?      // Nullable, only for Lab subjects
  remedial1         Int?      // Max 50, if CAT1 < 25
  remedial2         Int?      // Max 50, if CAT2 < 25
  remedial3         Int?      // Max 50, if CAT3 < 25
  
  attendancePercent Float     @default(0)
  internalMarksTotal Float    @default(0)
  
  staffApproved     Boolean   @default(false)
  approvedAt        DateTime?

  // AI Success Link
  aiPrediction      String?   @db.Text  // Success prediction/risk factor

  student User    @relation("EvaluationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  staff   User?   @relation("EvaluationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model FeeRecord {
  id               String    @id @default(uuid())
  studentId        String    @unique
  feeBalance       Float     @default(0)
  feeClearedAuto   Boolean   @default(false)
  feeClearedManual Boolean   @default(false)
  clearedAt        DateTime?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String   @id @default(uuid())
  studentId   String
  subjectId   String
  fileUrl     String
  aiFeedback  String?  @db.Text
  submittedAt DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
}

model HallTicket {
  id          String    @id @default(uuid())
  studentId   String    @unique
  isUnlocked  Boolean   @default(false)
  pdfUrl      String?
  qrCodeData  String?   @db.Text  // For verification
  verificationCode String? @unique // Human readable short code
  generatedAt DateTime?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'INFO', 'SUCCESS', 'WARNING', 'URGENT'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  type        String   // 'CAMPUS', 'DEPARTMENT', 'EXAM'
  priority    Int      @default(1) // 1: Low, 2: Medium, 3: High
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  
  // MULTI-TENANT RELATION
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([createdById])
}

model Material {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  fileUrl      String
  fileType     String   // 'PDF', 'DOC', 'IMAGE'
  category     String   // 'NOTES', 'SYLLABUS', 'QUESTION_PAPER'
  subjectId    String
  uploadedById String
  createdAt    DateTime @default(now())

  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("UploadedMaterials", fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([uploadedById])
}

model ExamAttendance {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  scannedById   String
  scannedAt     DateTime @default(now())
  verified      Boolean  @default(true)
  session       String   // e.g. "FN" or "AN"
  date          String   // e.g. "17/05/2026"

  student   User    @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scannedBy User    @relation("StaffAttendanceScans", fields: [scannedById], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date, session])
}

// RBAC: Custom Roles per College
model CustomRole {
  id          String   @id @default(uuid())
  name        String   // e.g., "Library Auditor", "Fee Manager"
  description String?
  permissions Json     // Array of permission keys, e.g., ["MANAGE_FEES", "VIEW_STUDENTS"]
  createdAt   DateTime @default(now())

  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  users       User[]

  @@unique([name, collegeId])
}
