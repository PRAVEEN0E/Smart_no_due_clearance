# =============================================================================
# NoDueNest - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sndc?sslmode=disable"

# Authentication
JWT_SECRET="replace-with-64-char-hex-secret-in-production"
BOOTSTRAP_SECRET="replace-with-32-char-hex-secret"

# Server
PORT=3000

# Client URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Email Configuration (EmailJS)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Email Configuration (Gmail SMTP - fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# External APIs
GROQ_API_KEY=your_groq_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sentry (Error Monitoring)
SENTRY_DSN=your_sentry_dsn

# Constants
ATTENDANCE_THRESHOLD=75
